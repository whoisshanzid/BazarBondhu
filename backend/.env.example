NODE_ENV=development
PORT=4000
# Comma-separated list is supported for multiple frontend origins.
CLIENT_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bazarbondhu
DB_PASSWORD=change_me
DB_NAME=bazarbondhu

# Hosted MySQL (Aiven, PlanetScale, etc.) usually requires TLS.
DB_SSL=false
# Base64-encoded CA certificate, e.g. base64 -i ca.pem
DB_SSL_CA_BASE64=
# Alternative to DB_SSL_CA_BASE64: path to a CA certificate file.
DB_SSL_CA_PATH=
# Set to false only if your provider uses a certificate Node cannot verify.
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional. Defaults to backend/uploads. Use a mounted volume in production.
UPLOAD_DIR=

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Only needed for npm run admin:set-password. Do not commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
